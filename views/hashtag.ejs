<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Hashtag</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<nav class="navbar">
  <div class="nav-left"><span class="logo">MyApp</span></div>
  <div class="nav-right">
    <button onclick="location.href='/'">Home</button>
    <button id="loginBtn" style="display:none">Login</button>
    <button id="signupBtn" style="display:none">Sign Up</button>
    <button id="profileBtn" style="display:none">Profile</button>
    <button id="logoutBtn" style="display:none">Logout</button>
  </div>
</nav>

<div class="container">
  <div class="hashtag-header">
    <h1 id="hashtagTitle">#</h1>
    <p id="hashtagMeta"></p>
    <div id="similarHashtags" class="similar-hashtags"></div>
  </div>
  <div id="hashtagPosts"></div>
</div>

<script src="/javascript.js"></script>
<script>
async function loadHashtag() {
  const tag = location.pathname.split('/hashtag/')[1];
  if (!tag) return;

  document.getElementById('hashtagTitle').textContent = '#' + tag;

  const res = await fetch('/hashtag/' + tag);
  const data = await res.json();

  document.getElementById('hashtagMeta').textContent = data.post_count + ' posts';

  // Render similar hashtags
  const similarDiv = document.getElementById('similarHashtags');
  similarDiv.innerHTML = '';
  if (data.similar_hashtags && data.similar_hashtags.length > 0) {
    const label = document.createElement('span');
    label.className = 'similar-label';
    label.textContent = 'Similar: ';
    similarDiv.appendChild(label);

    data.similar_hashtags.forEach(h => {
      const link = document.createElement('a');
      link.href = '/hashtag/' + h.tag;
      link.className = 'hashtag similar-tag';
      link.textContent = '#' + h.tag;
      link.title = h.post_count + ' posts · ' + h.reason;
      similarDiv.appendChild(link);
    });
  }

  // Render posts
  const container = document.getElementById('hashtagPosts');
  container.innerHTML = '';

  if (data.posts.length === 0) {
    container.innerHTML = '<p>No posts with this hashtag yet.</p>';
    return;
  }

  data.posts.forEach(post => {
    container.appendChild(createPostCard(post));
  });
}

if (window.loadMyInfoPromise) {
  window.loadMyInfoPromise.then(loadHashtag);
} else {
  loadHashtag();
}
</script>
</body>
</html>
